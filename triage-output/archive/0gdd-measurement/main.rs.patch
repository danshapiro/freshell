+    #[test]
+    fn level1_config_is_master_gated_and_complete() {
+        let _lock = crate::session_directory::HOME_ENV_TEST_LOCK.lock().unwrap();
+        let _guards = [
+            EnvVarGuard::unset("FRESHELL_0GDD_LEVEL1"),
+            EnvVarGuard::unset("FRESHELL_0GDD_SESSION_SWEEP"),
+            EnvVarGuard::unset("FRESHELL_0GDD_AUTO_TITLE_SWEEP"),
+            EnvVarGuard::unset("FRESHELL_0GDD_REFRESH_MODE"),
+            EnvVarGuard::unset("FRESHELL_0GDD_CACHE_WRITES"),
+        ];
+        let defaults = resolve_level1_config().unwrap();
+        assert_eq!(
+            defaults,
+            Level1Config {
+                active: false,
+                session_sweep: true,
+                auto_title_sweep: true,
+                refresh_mode: DiagnosticRefreshMode::Normal,
+                cache_writes: true,
+            }
+        );
+        let _sweep = EnvVarGuard::set("FRESHELL_0GDD_SESSION_SWEEP", "off");
+        assert!(resolve_level1_config().is_err());
+        let _gate = EnvVarGuard::set("FRESHELL_0GDD_LEVEL1", "1");
+        assert!(resolve_level1_config().is_err());
+        let _auto = EnvVarGuard::set("FRESHELL_0GDD_AUTO_TITLE_SWEEP", "on");
+        let _writes = EnvVarGuard::set("FRESHELL_0GDD_CACHE_WRITES", "off");
