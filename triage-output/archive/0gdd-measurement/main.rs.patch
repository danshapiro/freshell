+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum DiagnosticRefreshMode {
+    Normal,
+    TenSeconds,
+    WarmOnly,
+}
+
+impl DiagnosticRefreshMode {
+    fn ttl(self) -> Duration {
+        match self {
+            Self::Normal => Duration::from_secs(1),
+            Self::TenSeconds => Duration::from_secs(10),
+            Self::WarmOnly => Duration::MAX,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Level1Config {
+    active: bool,
+    session_sweep: bool,
+    auto_title_sweep: bool,
+    refresh_mode: DiagnosticRefreshMode,
+    cache_writes: bool,
+}
+
+fn resolve_level1_config() -> Result<Level1Config, String> {
+    const PREFIX: &str = "FRESHELL_0GDD_";
+    let gate = std::env::var("FRESHELL_0GDD_LEVEL1").ok();
+    if gate.is_none() {
+        if std::env::vars_os().any(|(key, _)| key.to_string_lossy().starts_with(PREFIX)) {
+            return Err("FRESHELL_0GDD_* controls require FRESHELL_0GDD_LEVEL1=1".into());
+        }
+        return Ok(Level1Config {
+            active: false,
+            session_sweep: true,
+            auto_title_sweep: true,
+            refresh_mode: DiagnosticRefreshMode::Normal,
+            cache_writes: true,
+        });
+    }
+    if gate.as_deref() != Some("1") {
+        return Err("FRESHELL_0GDD_LEVEL1 must be 1".into());
+    }
+    if let Some((key, _)) = std::env::vars().find(|(key, _)| {
+        key.strip_prefix(PREFIX).is_some_and(|suffix| {
+            !matches!(
+                suffix,
+                "LEVEL1" | "SESSION_SWEEP" | "AUTO_TITLE_SWEEP" | "REFRESH_MODE" | "CACHE_WRITES"
+            )
+        })
+    }) {
+        return Err(format!("unknown diagnostic control {key}"));
+    }
+    let toggle = |name| match std::env::var(name).as_deref() {
+        Ok("on") => Ok(true),
+        Ok("off") => Ok(false),
+        _ => Err(format!("{name} must be on or off")),
+    };
+    let refresh_mode = match std::env::var("FRESHELL_0GDD_REFRESH_MODE").as_deref() {
+        Ok("normal") => DiagnosticRefreshMode::Normal,
+        Ok("10s") => DiagnosticRefreshMode::TenSeconds,
+        Ok("warm-only") => DiagnosticRefreshMode::WarmOnly,
+        _ => return Err("FRESHELL_0GDD_REFRESH_MODE must be normal, 10s, or warm-only".into()),
+    };
+    Ok(Level1Config {
+        active: true,
+        session_sweep: toggle("FRESHELL_0GDD_SESSION_SWEEP")?,
+        auto_title_sweep: toggle("FRESHELL_0GDD_AUTO_TITLE_SWEEP")?,
+        refresh_mode,
+        cache_writes: toggle("FRESHELL_0GDD_CACHE_WRITES")?,
+    })
+}
